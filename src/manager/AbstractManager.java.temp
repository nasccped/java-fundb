package fundb.managers;

import fundb.exception.GenericRuntimeException;
import fundb.managers.result.ExecutionResultInterface;
import fundb.repl.evaluator.EvaluationResultInterface;

public abstract class AbstractManager {

    public static ExecutionResultInterface execute(EvaluationResultInterface eval) {
        throw GenericRuntimeException.missingFunctionImplementation(AbstractManager.class, "execute");
    }
}
